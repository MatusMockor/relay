{
  "name": "@relay/desktop",
  "productName": "Relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/renderer && tsc --noEmit -p test/integration",
    "test": "vitest run",
    "test:real-server": "vitest run test/integration/real-server",
    "native:electron": "electron-rebuild --force --only better-sqlite3",
    "native:node": "pnpm rebuild better-sqlite3"
  },
  "dependencies": {
    "@relay/ai": "workspace:*",
    "@relay/calendar": "workspace:*",
    "@relay/engine": "workspace:*",
    "@relay/mail-core": "workspace:*",
    "@relay/mcp-mail": "workspace:*",
    "@relay/shared": "workspace:*",
    "@relay/store-sqlite": "workspace:*",
    "better-sqlite3": "13.2.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@relay/config": "workspace:*",
    "@relay/ui": "workspace:*",
    "@tanstack/react-query": "5.90.21",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.3.2",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "eslint": "9.39.5",
    "imapflow": "1.7.8",
    "jsdom": "26.1.0",
    "nodemailer": "7.0.13",
    "pg": "8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7",
    "zustand": "5.0.16"
  }
}
