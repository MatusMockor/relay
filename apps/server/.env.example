NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgres://relay:relay@127.0.0.1:5432/relay
DATABASE_MIGRATE_ON_START=true
DATABASE_POOL_MAX=10

# openssl rand -base64 48 (two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

REGISTRATION_ENABLED=true
# Register, login and refresh attempts per client IP and per email address in one window
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Proxies in front of the server that add X-Forwarded-For. With 1 the client IP is the rightmost entry.
# Without a proxy, set 0, otherwise a client can spoof its IP for the per-IP limit.
TRUST_PROXY_HOPS=1

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Only for local test servers without TLS (e.g. GreenMail). Never enable in production.
MAIL_ALLOW_PLAINTEXT=false

JOBS_ENABLED=true
JOBS_TICK_MS=15000
JOBS_POLL_INTERVAL_SECONDS=2
IMAP_IDLE_ENABLED=true

# Optional: colon separated directories searched for the claude / codex CLIs instead of PATH
# AI_CLI_PATH=/usr/local/bin
